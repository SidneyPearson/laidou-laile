{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/worker.ts",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "bundle": "esbuild src/worker.ts --bundle --format=esm --platform=browser --outfile=../client/dist/_worker.js --define:process.env.NODE_ENV='\"production\"'",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251207.0",
    "esbuild": "^0.28.1",
    "typescript": "~5.7.3",
    "vitest": "^2.1.9",
    "wrangler": "^3.99.0"
  }
}

