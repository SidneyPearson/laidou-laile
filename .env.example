# Local dev only. Production runs on Cloudflare Pages `_worker.js` where
# these values come from wrangler.toml `[vars]` and `wrangler pages secret put`.
# Copy this file to server/.dev.vars for `wrangler dev` to pick up secrets.

# ── Server ───────────────────────────────────────────
NODE_ENV=development

# ── Amap Web Services API key (SERVER SIDE) ──────────
# Apply at: https://lbs.amap.com/dev/key/app
# NOTE: the front-end JS SDK key (in client/index.html) is a SEPARATE key.
#       Both are required. The JS key must have your domain whitelisted
#       in the Amap console; the Web-Services key does not.
AMAP_WEB_API_KEY=your_amap_web_key_here

# ── DeepSeek LLM ─────────────────────────────────────
# Apply at: https://platform.deepseek.com
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_MS=35000

# ── Amap ─────────────────────────────────────────────
AMAP_TIMEOUT_MS=10000
