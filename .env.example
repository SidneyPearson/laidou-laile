# Server
PORT=3000
NODE_ENV=development

# Amap Web Services API Key
# Apply at: https://lbs.amap.com/dev/key/app
AMAP_WEB_API_KEY=your_amap_key_here

# LLM (DeepSeek only — no GPT / Claude)
# Apply at: https://platform.deepseek.com
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=deepseek-v4-pro
LLM_TIMEOUT_MS=30000

# Amap
AMAP_TIMEOUT_MS=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# CORS
CORS_ORIGIN=*
